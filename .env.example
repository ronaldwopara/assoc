# Google reCAPTCHA v2 (“I’m not a robot” checkbox).
# Add asosc.ca, www.asosc.ca, and localhost for local testing.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Staff gate for /upgrade CMS + Operations dashboard (server-only)
UPGRADE_PASSWORD=
# Optional; defaults to UPGRADE_PASSWORD if unset
# UPGRADE_SESSION_SECRET=

# Cloudinary (image uploads + CMS JSON storage + encrypted Google refresh tokens)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (Interac email + Drive invoices + Sheets)
# Create at console.cloud.google.com → Google Auth Platform → Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an Authorized redirect URI on the OAuth client (see Production below)
GOOGLE_REDIRECT_URI=http://localhost:4000/api/google/callback
# AES key material for encrypting refresh tokens in Cloudinary (openssl rand -base64 32)
# Keep the same value across local + Vercel so tokens stored in Cloudinary stay decryptable.
GOOGLE_TOKEN_SECRET=
# The ASOSC master spreadsheet the Operations Hub reads from (the id in its URL)
GOOGLE_MASTER_SHEET_ID=
# The "Membership - Website" spreadsheet the membership form writes new rows into (the id in its URL)
MEMBERSHIP_SHEET_ID=
# Optional; defaults to the current year (e.g. "2026") to match that spreadsheet's per-year tabs
# MEMBERSHIP_SHEET_TAB=
# The "ASOSC Finances" spreadsheet — dashboard Payment Review > Donations reads its "<year>-Income" tab
FINANCE_SHEET_ID=

# -----------------------------------------------------------------------------
# Vercel Production checklist
# -----------------------------------------------------------------------------
# Copy every variable above into Vercel → Project → Settings → Environment Variables
# (Production). Vercel does not read .env or .env.local from the repo.
#
# Required overrides for Production:
#   GOOGLE_REDIRECT_URI=https://asosc.ca/api/google/callback
#   (add https://www.asosc.ca/api/google/callback too if you use www)
#
# Google Cloud Console → OAuth client → Authorized redirect URIs — add the same
# production callback URL(s) as GOOGLE_REDIRECT_URI.
#
# After env is set, redeploy, then connect Google once:
#   1. Sign in at /upgrade with UPGRADE_PASSWORD
#   2. Open /api/google/connect (must be signed in — route is staff-gated)
#   3. Approve with a Google account that can access the master/membership/finance sheets
#
# Refresh tokens are encrypted and stored in Cloudinary (google-tokens.json). They
# survive redeploys; you only reconnect if Google revokes access or GOOGLE_TOKEN_SECRET changes.
